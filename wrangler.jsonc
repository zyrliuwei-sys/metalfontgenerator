// Cloudflare Workers deploy config for metalfontgeneratorai.
// Binding IDs and routes are safe to commit; provider credentials stay in
// Cloudflare secrets or the admin settings database.
// `pnpm cf:build` (NITRO_PRESET=cloudflare_module) merges wrangler.jsonc into
// the generated .output/server/wrangler.json; deploy with `pnpm cf:deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metalfontgeneratorai",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    // Server-side runtime fallbacks for the build-time VITE_* values — keep in
    // sync with .env.production (better-auth trustedOrigins, payment callbacks).
    "VITE_APP_URL": "https://metalfontgenerator.org",
    "VITE_APP_NAME": "metalfontgenerator",
  },
  "routes": [{ "pattern": "metalfontgenerator.org", "custom_domain": true }],
  // Dedicated database, migrated from this project's Neon database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "metalfontgenerator-production",
      "database_id": "2d9b03ce-ee7d-4384-8581-7b23b13c8b04",
      "migrations_dir": "migrations/d1",
    },
  ],
  //
  // Other optional bindings — uncomment when needed:
  // "kv_namespaces":  [{ "binding": "CACHE",  "id": "..." }],
  // "r2_buckets":     [{ "binding": "BUCKET", "bucket_name": "..." }]
}
